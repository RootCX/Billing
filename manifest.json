{
  "appId": "billing",
  "name": "Billing",
  "version": "0.1.0",
  "description": "Professional invoicing and billing management",
  "dataContract": [
    {
      "entityName": "customer",
      "fields": [
        { "name": "company_name", "type": "text", "required": true },
        { "name": "vat_number", "type": "text" },
        { "name": "street", "type": "text" },
        { "name": "city", "type": "text" },
        { "name": "postal_code", "type": "text" },
        { "name": "country_code", "type": "text" },
        { "name": "notes", "type": "text" }
      ]
    },
    {
      "entityName": "contact",
      "fields": [
        { "name": "customer_id", "type": "entity_link", "references": { "entity": "customer", "field": "id" }, "required": true },
        { "name": "first_name", "type": "text", "required": true },
        { "name": "last_name", "type": "text" },
        { "name": "email", "type": "text" },
        { "name": "phone", "type": "text" },
        { "name": "job_title", "type": "text" },
        { "name": "is_default", "type": "boolean" }
      ]
    },
    {
      "entityName": "invoice",
      "fields": [
        { "name": "invoice_number", "type": "text", "required": true },
        { "name": "status", "type": "text", "enum_values": ["draft", "sent", "paid", "overdue", "cancelled"], "required": true },
        { "name": "invoice_date", "type": "date", "required": true },
        { "name": "due_date", "type": "date", "required": true },
        { "name": "currency", "type": "text", "required": true },
        { "name": "vat_treatment", "type": "text", "enum_values": ["standard", "exempt", "reverse_charge", "intra_eu", "export"] },
        { "name": "client_company", "type": "text" },
        { "name": "client_vat", "type": "text" },
        { "name": "client_street", "type": "text" },
        { "name": "client_city", "type": "text" },
        { "name": "client_postal", "type": "text" },
        { "name": "client_country", "type": "text" },
        { "name": "client_contact_name", "type": "text" },
        { "name": "client_contact_email", "type": "text" },
        { "name": "line_items", "type": "json" },
        { "name": "references", "type": "json" },
        { "name": "internal_notes", "type": "text" },
        { "name": "terms", "type": "text" },
        { "name": "subtotal", "type": "number" },
        { "name": "total_tax", "type": "number" },
        { "name": "total", "type": "number" }
      ]
    },
    {
      "entityName": "seller_settings",
      "fields": [
        { "name": "company_name", "type": "text", "required": true },
        { "name": "vat_number", "type": "text" },
        { "name": "street", "type": "text" },
        { "name": "city", "type": "text" },
        { "name": "postal_code", "type": "text" },
        { "name": "country_code", "type": "text" },
        { "name": "email", "type": "text" },
        { "name": "phone", "type": "text" },
        { "name": "iban", "type": "text" },
        { "name": "bic", "type": "text" },
        { "name": "logo", "type": "text" },
        { "name": "default_currency", "type": "text" },
        { "name": "default_vat_rate", "type": "number" },
        { "name": "invoice_prefix", "type": "text" },
        { "name": "default_terms", "type": "text" }
      ]
    },
    {
      "entityName": "peppol_registration",
      "fields": [
        { "name": "peppol_id", "type": "text" },
        { "name": "dokapi_ulid", "type": "text" },
        { "name": "status", "type": "text", "enum_values": ["not_registered", "pending", "active", "failed"], "required": true },
        { "name": "document_types_registered", "type": "boolean" },
        { "name": "business_card_pushed", "type": "boolean" },
        { "name": "error_message", "type": "text" }
      ]
    },
    {
      "entityName": "peppol_send_log",
      "fields": [
        { "name": "invoice_id", "type": "entity_link", "references": { "entity": "invoice", "field": "id" }, "required": true },
        { "name": "invoice_number", "type": "text" },
        { "name": "status", "type": "text", "enum_values": ["pending", "sent", "delivered", "failed"], "required": true },
        { "name": "dokapi_ulid", "type": "text" },
        { "name": "sender_peppol_id", "type": "text" },
        { "name": "receiver_peppol_id", "type": "text" },
        { "name": "ubl_xml", "type": "text" },
        { "name": "error_message", "type": "text" },
        { "name": "sent_at", "type": "timestamp" }
      ]
    }
  ],
  "permissions": {
    "permissions": [
      { "key": "customer.read", "description": "View customers" },
      { "key": "customer.write", "description": "Create and edit customers" },
      { "key": "customer.delete", "description": "Delete customers" },
      { "key": "contact.read", "description": "View contacts" },
      { "key": "contact.write", "description": "Create and edit contacts" },
      { "key": "contact.delete", "description": "Delete contacts" },
      { "key": "invoice.read", "description": "View invoices" },
      { "key": "invoice.write", "description": "Create and edit invoices" },
      { "key": "invoice.delete", "description": "Delete invoices" },
      { "key": "seller_settings.read", "description": "View seller settings" },
      { "key": "seller_settings.write", "description": "Edit seller settings" },
      { "key": "peppol_registration.read", "description": "View Peppol registration" },
      { "key": "peppol_registration.write", "description": "Manage Peppol registration" },
      { "key": "peppol_send_log.read", "description": "View Peppol send history" },
      { "key": "peppol_send_log.write", "description": "Create Peppol send log entries" }
    ]
  }
}
